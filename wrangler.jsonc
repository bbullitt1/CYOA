{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyoa",
  "main": "_worker.js",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "branched-users",
      "database_id": "08fa782b-8739-4186-b02e-f96767e00cd3"
    }
  ]
}
