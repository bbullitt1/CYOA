{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyoa",
  "main": "_worker.js",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "branched-users",
      "database_id": "PLACEHOLDER_REPLACE_WITH_REAL_ID"
    }
  ]
}
